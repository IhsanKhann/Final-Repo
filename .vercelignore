# Ignore root Python backend, data, docs (only needed locally/in repo)
/backend
/backend/**
/data
/data/**
/docs
/docs/**

# Ignore terraform
/terraform
/terraform/**
doc-standardization-pipeline/terraform
doc-standardization-pipeline/terraform/**
.terraform
**/.terraform/**
*.tfstate*

# Ignore git and environments
.git
.github
.venv
venv
**/__pycache__/**
**/*.pyc
.env*
!.env.example

# Ignore logs and scratch
logs
*.log
/scratch
/scratch/**

# ALWAYS IGNORE NODE_MODULES AND DIST AT ANY LEVEL (MUST BE AT END)
**/node_modules
**/node_modules/**
node_modules
**/dist
**/dist/**
dist
