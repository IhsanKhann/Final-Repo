# ==============================================================================
# Environment Configuration for React + Node.js GCP Document AI & OpenAI Pipeline
# ==============================================================================

# Backend Port
PORT=8080

# OpenAI API Key (Mandatory for Step 3 Agentic Normalization with GPT-4o)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Google Cloud Platform Configuration
GCP_PROJECT_ID=doc-standardization-pipeline-demo
GCP_LOCATION=us

# Document AI Configuration
DOCAI_PROCESSOR_ID=your-docai-processor-id

# Google Cloud Storage Buckets
SOURCE_BUCKET_NAME=docai-source-documents-staging
DESTINATION_BUCKET_NAME=docai-normalized-json-output

# Google Cloud BigQuery Configuration
BIGQUERY_DATASET_ID=doc_standardization_pipeline
BIGQUERY_NORMALIZED_TABLE=normalized_records
BIGQUERY_REVIEW_TABLE=review_queue

# Frontend Configuration (Optional for production builds)
VITE_BACKEND_URL=http://localhost:8080
